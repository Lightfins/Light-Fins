# ============================================
# TradingClaw Environment Variables
# Copy this to trading/.env and fill in values
# ============================================

# Claude API (from your Claude Pro subscription)
# Get your key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hyperliquid (Phase 2 - live trading)
# Leave empty to run in read-only/simulation mode
HYPERLIQUID_SECRET_KEY=
HYPERLIQUID_WALLET_ADDRESS=

# CCXT Exchanges (Phase 2 - optional, for multi-exchange)
# BINANCE_API_KEY=
# BINANCE_SECRET=

# Trading configuration
TRADING_WORKSPACE=trading/workspace
TRADING_DATA_DIR=trading/data
TRADING_LOG_DIR=trading/logs

# Dashboard
STREAMLIT_PORT=8501

# Safety: set to "true" to start in read-only mode
START_READ_ONLY=true
